# ===== 运行时大件：由 scripts/安装.cmd 自动下载，不进版本库 =====
/kirara/
/napcat/
*.zip
*.7z

# ===== 密钥与本机配置 =====
.env
.env.local
token.txt
/config/kirara.config.local.yaml

# ===== 表情包图库 =====
