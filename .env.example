# 复制这个文件为 .env 并填入真实值。.env 已被 .gitignore 排除，切勿提交。

# ---------- 必填 ----------
# DeepSeek API Key（https://platform.deepseek.com/ 申请）
# 聊天用 deepseek-flash，看图用 deepseek-v4-flash-vision-exp，同一个 key 就够
DEEPSEEK_API_KEY=sk-在这里填你的key

# 你自己的 QQ 号（主人）。填了才会启用"严格模式"：
#   只有你的私聊会触发完整人设与工具；陌生人私聊只记录不回复；
#   群里只有被@、/chat 开头或明确要图/要提醒时才回。
# 留空则是宽松模式：任何人都能聊、群里每条都回（烧钱且扰民，不建议）
OWNER_QQ=

# ---------- 常用 ----------
# kirara WebUI 管理密码（首次安装时自己定一个，别用示例值）
KIRARA_WEBUI_PASSWORD=ChangeMe@1234

# kirara 与 NapCat 之间的反向 WebSocket 握手口令（只走 127.0.0.1，不对外暴露，
# 但属于本机配置，别提交进仓库）。留空则安装脚本自动生成一个随机值。
ONEBOT_TOKEN=

# NapCat WebUI 端口（多开时改成别的，避免和另一个实例冲突）
NAPCAT_WEBUI_PORT=6100

# 本地图库服务端口
GALLERY_PORT=3100

# 机器人的 QQ 号（扫码登录后填，用于免扫码快速登录与状态自检）
BOT_QQ=

# ---------- 守护进程 ----------
# 巡检间隔（秒）。掉线会自动拉起并在状态变化时给你发一条 QQ 私聊
WATCHDOG_INTERVAL=60
